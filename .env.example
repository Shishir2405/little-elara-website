# ── Copy this file to .env.local and fill in the values ──

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=

# Brevo transactional email (https://app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=
# A sender that is verified in your Brevo account
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Little Elara Steps

# The single admin who can log in (OTP is emailed here). Run `pnpm seed:admin` after setting this.
ADMIN_EMAIL=
ADMIN_NAME=Admin

# Where new-enquiry notifications are sent (defaults to ADMIN_EMAIL)
NOTIFY_EMAIL=

# Secret for signing the admin session + hashing OTPs. Use a long random string:
#   openssl rand -base64 32
AUTH_SECRET=
