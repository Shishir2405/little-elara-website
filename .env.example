# ── Copy this file to .env.local and fill in the values (never commit real secrets) ──

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=

# Brevo HTTP API key — must start with "xkeysib-" (NOT the SMTP key "xsmtpsib-").
# Get it in Brevo → SMTP & API → API Keys → Generate a new API key.
BREVO_API_KEY=
# A sender address verified in your Brevo account
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Little Elara Steps

# The single admin who can log in (OTP is emailed here). Run `pnpm seed:admin` after setting this.
ADMIN_EMAIL=
ADMIN_NAME=Admin

# Where new-enquiry notifications are sent (defaults to ADMIN_EMAIL). Use an email address.
NOTIFY_EMAIL=

# Secret for signing the admin session + hashing OTPs. Use a long random string:
#   openssl rand -base64 32
AUTH_SECRET=
